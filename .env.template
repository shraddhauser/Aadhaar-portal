# Aadhaar Portal - Environment Configuration
# Copy this file to .env and update for your local database.

# Database Configuration
DB_ENGINE=sqlite
DB_FILE=./aadhaar_analytics.db
DB_URL=

# MySQL settings (only used when DB_ENGINE=mysql)
DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aadhaar_analytics

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Runtime environment: development | production
# In production the server refuses to start without JWT_SECRET_KEY.
ENV=development

# JWT signing key. Leave empty in development to get a random key per run
# (logins reset on restart). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Admin account created by scripts/create_admin.py (prompted for if empty)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Maximum CSV upload size for /api/import/* (megabytes)
MAX_UPLOAD_MB=10

# AI chatbot (Anthropic Claude). Without a key, /api/chat/ask returns 503.
ANTHROPIC_API_KEY=
